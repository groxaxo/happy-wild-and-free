# ============================================
# Required — standalone (yarn standalone:dev)
# ============================================
DB_PROVIDER=pglite
HANDY_MASTER_SECRET=your-super-secret-key-for-local-development
PORT=3005
NODE_ENV=development

# ============================================
# Optional — standalone works without these
# ============================================

# Metrics server
METRICS_ENABLED=true
METRICS_PORT=9090

# Centralized logging for AI debugging (creates .logs directory)
DANGEROUSLY_LOG_TO_SERVER_FOR_AI_AUTO_DEBUGGING=true

# ============================================
# Full deployment only (NOT needed for standalone)
# Uncomment and set DB_PROVIDER=postgres to use
# ============================================

# DB_PROVIDER=postgres
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/handy

# Redis (cross-process pub/sub)
# REDIS_URL=redis://localhost:6379

# S3/MinIO — file storage (start with `yarn s3`)
# S3_HOST=localhost
# S3_PORT=9000
# S3_USE_SSL=false
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=happy
# S3_PUBLIC_URL=http://localhost:9000/happy

# Voice — 11Labs API key (secret, not checked in)
# ELEVENLABS_API_KEY=

# Local web voice — OpenAI-compatible narration LLM, speech (TTS), and transcription (STT)
# Set LOCAL_VOICE_LLM_PROVIDER to: openai | codex | xai | local
LOCAL_VOICE_LLM_PROVIDER=openai
# OpenAI-compatible base URL; change to a local server (e.g. Ollama, LM Studio, vllm) as needed
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=llama3.1:8b
CODEX_EXEC_MODEL=gpt-4o
CODEX_EXEC_REASONING_EFFORT=medium
CODEX_EXEC_TIMEOUT_MS=45000
# OPENAI_API_KEY= — optional for unauthenticated OpenAI-compatible servers; required for api.openai.com and any host that expects Bearer auth
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_RESPONSES_MODEL=gpt-4o
OPENAI_RESPONSES_REASONING_EFFORT=high
OPENAI_RESPONSES_MAX_OUTPUT_TOKENS=4096
# TTS — set LOCAL_VOICE_TTS_PROVIDER to: openai | xai | chatterbox_multilingual | neutts
LOCAL_VOICE_TTS_PROVIDER=openai
LOCAL_TTS_PROVIDER=openai
LOCAL_TTS_REQUEST_TIMEOUT_MS=60000
# OpenAI-compatible TTS (POST /v1/audio/speech) — works with openai, Kokoro, piper-tts, etc.
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_RESPONSE_FORMAT=mp3
# STT — OpenAI-compatible transcription endpoint (POST /v1/audio/transcriptions)
# Point to a local Whisper server, faster-whisper, or any OpenAI-compatible ASR
LOCAL_ASR_BASE_URL=http://127.0.0.1:5092/v1
LOCAL_ASR_MODEL=whisper-1

# Local web voice — xAI fallback (secret, not checked in)
# XAI_API_KEY=
XAI_API_BASE_URL=https://api.x.ai/v1
XAI_RESPONSES_MODEL=grok-3-mini
XAI_RESPONSES_MAX_OUTPUT_TOKENS=1000000
XAI_TTS_VOICE=eve
XAI_TTS_LANGUAGE=auto

# Local web voice — Chatterbox multilingual text-to-speech (self-hosted)
CHATTERBOX_MULTILINGUAL_TTS_BASE_URL=http://127.0.0.1:8020/v1
CHATTERBOX_MULTILINGUAL_TTS_MODEL=tts-1-es
CHATTERBOX_MULTILINGUAL_TTS_VOICE=latina
CHATTERBOX_MULTILINGUAL_TTS_LANGUAGE=es
CHATTERBOX_MULTILINGUAL_TTS_RESPONSE_FORMAT=mp3
# CHATTERBOX_MULTILINGUAL_TTS_AUDIO_PROMPT_PATH=/path/to/reference_audio.wav

# Voice webhook secret (shared between ElevenLabs webhook config and this server)
# VOICE_WEBHOOK_SECRET=

# Local scripting — set ELEVENLABS_ANALYTICS_KEY in your shell env for scripts/voice-usage.py
# ELEVENLABS_ANALYTICS_KEY=
